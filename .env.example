# Copy to .env in the repo root (gitignored) and fill in. Read by the backend at
# startup (start it from the repo root). Real environment variables take precedence.
# Plain KEY=value lines; quotes around values are optional.

# Microsoft Azure Speech (optional: without a key only Kokoro is offered)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=switzerlandnorth

# Local Kokoro-FastAPI server
KOKORO_BASE_URL=http://localhost:8880

# Optional shared token. When set, every /api/** request must send it in the
# X-Chapterly-Token header; enter the same value under extension Settings > API token.
# Set it whenever the backend is reachable from other machines. Generate one with e.g.
#   openssl rand -hex 24
CHAPTERLY_API_TOKEN=

# docker compose only: the host address the backend port is published on. Default
# 127.0.0.1 (this machine only). To reach it from another laptop over Tailscale, use this
# machine's Tailscale IP (tailscale ip -4), e.g. 100.101.102.103. Not 0.0.0.0: that also
# opens it to everyone on the same Wi-Fi/LAN.
# CHAPTERLY_BIND=127.0.0.1
