{
  "manifest_version": 3,
  "name": "Chapterly",
  "version": "0.5.0",
  "description": "Reads web novel chapters and selected text aloud using your local Chapterly backend.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "offscreen", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Chapterly",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "play-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Play / pause reading"
    },
    "next-paragraph": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "Next paragraph"
    },
    "previous-paragraph": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "Previous paragraph"
    },
    "faster": {
      "description": "Read faster (+0.1x)"
    },
    "slower": {
      "description": "Read slower (-0.1x)"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
